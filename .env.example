# Токен бота от @BotFather
BOT_TOKEN=your_bot_token_here

# Пароль для входа в админ-панель
ADMIN_PASSWORD=your_secret_password_here

# TON-кошелёк для приёма оплаты (формат UQ... или EQ...)
TON_WALLET=UQyour_ton_wallet_address_here

# API-ключ TON Center (бесплатно на toncenter.com)
TON_API_KEY=your_toncenter_api_key_here
